main {
  margin-top: 2rem;
}

* {
  margin: 0;
  padding: 0;
  font-family: Roboto, sans-serif;
}

.highlight {
  background-image: linear-gradient(to top, #9b9b9b8c 50%, #0000 50%);
  background-position: 0 90%;
  background-repeat: no-repeat;
  background-size: 100% .6em;
}

.seccion-flexible {
  text-align: center;
  background-image: linear-gradient(#fff, #ffefd6);
  flex-direction: column;
  gap: 1.5rem;
  padding: 3rem 0 12rem;
  display: flex;
}

.container-badgets {
  flex-direction: row;
  justify-content: center;
  gap: 2rem;
  display: flex;
}

.badget {
  flex: row;
  align-items: center;
  gap: .5rem;
  font-weight: 300;
  display: flex;
}

.badget-icon {
  border-radius: 50%;
}

h1 {
  font-size: 4rem;
  font-weight: 400;
}

.subtitulo {
  font-size: 2rem;
  font-weight: 300;
}

.container-botones {
  justify-content: center;
  gap: 2rem;
  margin-top: .5rem;
  display: flex;
}

.boton-principal, .boton-secundario {
  color: #000;
  border-radius: 8px;
  padding: .7rem 1.2rem;
  text-decoration: none;
  transition: all 1s;
}

.boton-principal {
  background-color: #ffa826;
}

.boton-secundario {
  border: 1px solid #ffa826;
}

.seccion-informativa {
  z-index: 2;
  background-color: #fff;
  border-radius: 10px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 1.5rem;
  width: 80%;
  margin: auto;
  padding: 3rem 2rem;
  display: flex;
  position: relative;
  top: -4rem;
  box-shadow: 0 4px 8px #0000001a;
}

.h2-informativa {
  text-align: center;
  font-size: 2rem;
  font-weight: 300;
}

.img-informativa {
  border-radius: 1rem;
}

.p-informativa {
  text-align: center;
  width: 90%;
  font-size: 1.5rem;
  font-weight: 300;
}

@media (width <= 400px) {
  .seccion-flexible {
    text-align: left;
    gap: 1.5rem;
    padding: 3rem 1.5rem 10rem;
  }

  .subtitulo {
    font-size: 1.5rem;
  }

  h1 {
    font-size: 3rem;
  }

  .seccion-informativa {
    padding: 2rem 1.5rem;
  }

  .img-informativa {
    width: 100%;
  }

  .p-informativa {
    text-align: left;
    width: 100%;
    font-size: 1.3rem;
  }

  .h2-informativa {
    text-align: left;
  }

  .container-botones, .container-badgets {
    justify-content: left;
  }
}
/*# sourceMappingURL=Ruta grupal.6f8eb68f.css.map */
